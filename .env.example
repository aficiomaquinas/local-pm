DATABASE_URI=mongodb://localhost:27018/local-pm
PAYLOAD_SECRET=local-pm-secret-key-for-development-only
NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# ── OIDC (apps/web) — ADR-002 D1: issuer-agnostic, discovery-driven ──────────
# SPC-006 §13. Feature flag: false (default) = today's behavior, byte for byte.
# Local email/password login, first-register and the master user are untouched
# while OD-1 stays open (M7 = disableLocalStrategy:true is operator-gated).
#
# Compose profile alternative (no .env needed): the docker-compose.yml `oidc`
# profile ships app-oidc + dex with the OIDC_* env baked in —
#   COMPOSE_PROFILES=oidc docker compose up --build
# (set COMPOSE_PROFILES=oidc in the shell/.env, NOT `--profile oidc` alone:
# the flag ADDS to the implicit default profile and both app variants would
# claim 127.0.0.1:3010; an explicit COMPOSE_PROFILES value is replaced by the
# flag, keeping the two shapes exclusive).
OIDC_ENABLED=false                          # feature flag; false = today's behavior
OIDC_ISSUER=                                # e.g. https://id.lan/dex  (discovery: /.well-known/openid-configuration)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=                          # default: ${NEXT_PUBLIC_SERVER_URL}/api/auth/oidc/callback
OIDC_SCOPE=openid profile email
OIDC_GROUPS_CLAIM=groups                    # claims→roles source (§7); alternatives: roles, local_pm_roles
OIDC_ROLE_MAP={}                            # JSON: claim value → superadmin|human|agent
OIDC_SUPERADMIN_GROUP=                      # optional single-value sugar: this claim value = superadmin
OIDC_AGENT_CLIENT_IDS=[]                    # JSON array of agent client_ids
OIDC_AGENT_CLIENT_ID_CLAIM=azp              # azp | client_id | cid
OIDC_AUDIENCE=                              # expected aud for agent tokens (jwks mode); empty = skip aud check
OIDC_VERIFY_MODE=jwks                       # jwks | introspection (RFC 7662)
OIDC_INTROSPECTION_URL=                     # discovery-provided when verify mode is introspection; override here
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_DISCOVERY_TTL_SECONDS=3600
OIDC_JWKS_CACHE_SECONDS=600                 # proactive refetch window; unknown kid forces immediate refetch
OIDC_COOKIE_SECURE=auto                     # auto = secure unless NEXT_PUBLIC_SERVER_URL is http://localhost|127.0.0.1

# ── OIDC agent client (packages/mcp-server) ──────────────────────────────────
# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET (same names; the agent
# client's OWN values from the MCP process env — never the human's).
OIDC_SCOPE_MCP=                             # optional scope for the client_credentials grant
